{
  "name": "cleanfleet-command-center",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "HTTPS=true vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "worker:dev": "wrangler dev",
    "worker:deploy": "npm run build && wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply cleanfleet-d1 --local",
    "d1:migrate:remote": "wrangler d1 migrations apply cleanfleet-d1 --remote"
  },
  "dependencies": {
    "@turf/turf": "^7.2.0",
    "clsx": "^2.1.1",
    "idb": "^8.0.2",
    "lucide-react": "^1.16.0",
    "maplibre-gl": "^5.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250303.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "fake-indexeddb": "^6.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "wrangler": "^3.114.0"
  }
}
