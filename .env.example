# CleanFleet Command Center Environment Variables

# Vehicle identifier to track
VITE_VEHICLE_ID=CF-BIKE-001

# Real GPS tracking sample & send frequency (milliseconds)
VITE_TRACK_INTERVAL_MS=3000

# Command center polling frequency (milliseconds)
VITE_DASHBOARD_POLL_INTERVAL_MS=3000

# Route deviation threshold buffer corridor (meters)
VITE_ROUTE_DEVIATION_THRESHOLD_METERS=75

# GPS stale threshold (seconds) -> Vehicle marked STALE if no GPS
VITE_STALE_AFTER_SECONDS=90

# GPS delayed threshold (seconds) -> Vehicle marked DELAYED
VITE_DELAYED_AFTER_SECONDS=30

# Bearer Token for tracker authentication (sent in Authorization: Bearer <TOKEN>)
VITE_TRACKER_TOKEN=cleanfleet-tracker-secret-token

# Base URL for API (leave empty if frontend and worker are deployed on same origin)
VITE_API_BASE_URL=

# Cloudflare Worker Secrets (configured via wrangler secret put or Cloudflare dashboard):
# TRACKER_SECRET=cleanfleet-tracker-secret-token

